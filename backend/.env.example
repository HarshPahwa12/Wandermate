# Copy to backend/.env and fill in. .env is git-ignored.

# Supabase Postgres: dashboard -> Connect -> "Session pooler" (the direct connection is IPv6-only).
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password

# Signs our own session tokens. Use a long random string (32+ bytes).
JWT_SECRET=change-me

# Browser origins allowed to call the API and open the chat WebSocket. In production: the Netlify URL (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Optional: Google OAuth "Web application" client id. Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

# Optional: SMTP for password-reset emails. Empty SMTP_HOST just logs the reset link instead (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=WanderMate <no-reply@wandermate.local>

# Used to build the reset link in the email. Set to your deployed frontend URL in production.
FRONTEND_URL=http://localhost:3000
