# Copy to .env.local for local work. In Netlify set the same names under Environment variables.
# NEXT_PUBLIC_* values are baked into the build, so change them and redeploy.

# Where the backend lives. Locally http://localhost:8080; in production the Render URL (https, no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google sign-in is switched off in the UI for now. Leave empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
